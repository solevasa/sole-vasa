---
// src/pages/workshops.astro
---
<!doctype html>
<html lang="sv">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Workshops | Solé Vasa</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Italiana&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-vanilla: #FAF8F5;
      --bg-card: #F4F0E8;
      --text-main: #141414;
      --text-muted: #625E56;
      --accent-orange: #C97A52;
      --border-color: #EAE5DA;
      --font-heading: 'Italiana', serif;
      --font-body: 'Plus Jakarta Sans', -apple-system, sans-serif;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--bg-vanilla); color: var(--text-main); font-family: var(--font-body); }
    header { border-bottom: 1px solid var(--border-color); padding: 1.4rem 2rem; display: flex; justify-content: space-between; align-items: center; max-width: 1140px; margin: 0 auto; }
    .brand { display: flex; align-items: center; gap: 0.8rem; text-decoration: none; color: inherit; font-family: var(--font-heading); font-size: 2.2rem; }
    .back { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--text-muted); text-decoration: none; }
    main { max-width: 1140px; margin: 0 auto; padding: 4.5rem 2rem 6rem; }
    .intro { text-align: center; max-width: 720px; margin: 0 auto 4rem; }
    h1 { font-family: var(--font-heading); font-size: 3.2rem; margin-bottom: 0.8rem; }
    .workshop-list { display: flex; flex-direction: column; gap: 2.5rem; max-width: 820px; margin: 0 auto; }
    .item { background: var(--bg-card); padding: 2.5rem; border-radius: 2px; display: grid; grid-template-columns: 1fr 180px; gap: 2rem; align-items: center; }
    .item h2 { font-family: var(--font-heading); font-size: 1.8rem; margin-bottom: 0.4rem; }
    .item p { font-size: 0.92rem; color: var(--text-muted); font-weight: 300; }
    .price-box { text-align: right; }
    .price-tag { font-size: 1.3rem; font-weight: 600; color: var(--accent-orange); display: block; margin-bottom: 0.8rem; }
    .btn-book { display: inline-block; background: var(--text-main); color: var(--bg-vanilla); padding: 0.65rem 1.4rem; border-radius: 999px; text-decoration: none; font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; }
    @media(max-width: 650px) {
      .item { grid-template-columns: 1fr; text-align: center; }
      .price-box { text-align: center; }
    }
  </style>
</head>
<body>
  <header>
    <a href="/" class="brand"><img src="/flower.png" alt="Solé Vasa" style="width:34px; height:34px;" />Solé Vasa</a>
    <a href="/" class="back">&larr; Tillbaka till start</a>
  </header>
  <main>
    <div class="intro">
      <h1>Kreativa Workshops</h1>
      <p style="color:var(--text-muted);">Samla vänner eller kollegor och lär er konsten att binda buketter och kransar i vår mysiga butik.</p>
    </div>
    <div class="workshop-list">
      <div class="item">
        <div>
          <h2>Kransbindning i Säsong</h2>
          <p>Lär dig teknikerna bakom en luftig och hållbar krans med naturmaterial och torkade inslag. Allt material och fika ingår.</p>
        </div>
        <div class="price-box">
          <span class="price-tag">850 kr / pers</span>
          <a href="mailto:flowers@solevasa.se?subject=Bokning Kransbindning" class="btn-book">Boka plats</a>
        </div>
      </div>

      <div class="item">
        <div>
          <h2>Spiralteknik &amp; Bukettmakeri</h2>
          <p>En djupdykning i hur du bygger en harmonisk snittblomsbukett i spiralform med proffsens knep för bästa hållbarhet.</p>
        </div>
        <div class="price-box">
          <span class="price-tag">650 kr / pers</span>
          <a href="mailto:flowers@solevasa.se?subject=Bokning Spiralteknik" class="btn-book">Boka plats</a>
        </div>
      </div>

      <div class="item">
        <div>
          <h2>Privat Grupp / Företagsevent</h2>
          <p>Vill ni ha en egen kväll i butiken med bubbel, snittblommor och skapande? Vi skräddarsyr upplägget efter ert sällskap.</p>
        </div>
        <div class="price-box">
          <span class="price-tag">Offert</span>
          <a href="mailto:flowers@solevasa.se?subject=Förfrågan Privat Workshop" class="btn-book">Skicka förfrågan</a>
        </div>
      </div>
    </div>
  </main>
</body>
</html>
