---
// src/pages/brollop-och-fest.astro
---
<!doctype html>
<html lang="sv">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bröllop & Fest | Solé Vasa</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Italiana&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-vanilla: #FAF8F5;
      --bg-card: #F4F0E8;
      --text-main: #141414;
      --text-muted: #625E56;
      --accent-orange: #C97A52;
      --border-color: #EAE5DA;
      --font-heading: 'Italiana', serif;
      --font-body: 'Plus Jakarta Sans', -apple-system, sans-serif;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--bg-vanilla); color: var(--text-main); font-family: var(--font-body); }
    header { border-bottom: 1px solid var(--border-color); padding: 1.4rem 2rem; display: flex; justify-content: space-between; align-items: center; max-width: 1140px; margin: 0 auto; }
    .brand { display: flex; align-items: center; gap: 0.8rem; text-decoration: none; color: inherit; font-family: var(--font-heading); font-size: 2.2rem; }
    .back { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--text-muted); text-decoration: none; }
    main { max-width: 1140px; margin: 0 auto; padding: 4.5rem 2rem 6rem; }
    .intro { text-align: center; max-width: 720px; margin: 0 auto 4rem; }
    h1 { font-family: var(--font-heading); font-size: 3.2rem; margin-bottom: 0.8rem; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 2.5rem; }
    .card { display: flex; flex-direction: column; }
    .card img { width: 100%; aspect-ratio: 4/5; object-fit: cover; background: var(--bg-card); margin-bottom: 1rem; border-radius: 2px; }
    .card-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.3rem; }
    .card-title { font-family: var(--font-heading); font-size: 1.45rem; }
    .card-price { font-weight: 600; color: var(--accent-orange); font-size: 0.88rem; }
    .card-desc { font-size: 0.86rem; color: var(--text-muted); font-weight: 300; }
    .cta-box { background: var(--bg-card); padding: 3rem 2rem; text-align: center; margin-top: 5rem; border-radius: 2px; }
    .cta-box a { display: inline-block; background: var(--text-main); color: var(--bg-vanilla); padding: 0.85rem 2rem; border-radius: 999px; text-decoration: none; font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; margin-top: 1rem; }
  </style>
</head>
<body>
  <header>
    <a href="/" class="brand"><img src="/flower.png" alt="Solé Vasa" style="width:34px; height:34px;" />Solé Vasa</a>
    <a href="/" class="back">&larr; Tillbaka till start</a>
  </header>
  <main>
    <div class="intro">
      <h1>Bröllop &amp; Fest</h1>
      <p style="color:var(--text-muted);">Skräddarsydd blomsterdesign och installationer för livets stora stunder.</p>
    </div>
    <div class="grid">
      <div class="card">
        <img src="/brollop_bukett1.JPG" alt="Brudbukett " />
        <div class="card-head"><h2 class="card-title">Brudbukett Botanisk</h2><span class="card-price">från 1 400 kr</span></div>
        <p class="card-desc">Skräddarsydd efter stil, klädsel och färgpalett.</p>
      </div>
      <div class="card">
        <img src="/brollop_brud.JPG" alt="Tärnbukett" />
        <div class="card-head"><h2 class="card-title">Tärnbukett</h2><span class="card-price">från 500 kr</span></div>
        <p class="card-desc">Harmoniserande mindre arrangemang för tärnor.</p>
      </div>
      <div class="card">
        <img src="/brollop_dukning.JPG" alt="Bordsdekorationer" />
        <div class="card-head"><h2 class="card-title">Bordsdekorationer</h2><span class="card-price">från 150 kr / st</span></div>
        <p class="card-desc">Vackra bordsarrangemang anpassade för middagsdukningen.</p>
      </div>
      <div class="card">
        <img src="/brollop_bukett.JPG" alt="Corsage" />
        <div class="card-head"><h2 class="card-title">Corsage / Knapphål</h2><span class="card-price">från 220 kr</span></div>
        <p class="card-desc">Exakta detaljer för kavajslag och brudfölje.</p>
      </div>
      <div class="card">
        <img src="/brollop1.JPG" alt="Blomsterbåge" />
        <div class="card-head"><h2 class="card-title">Blomsterbåge </h2><span class="card-price">Offert</span></div>
        <p class="card-desc">Mäktiga blomstervalv för vigsel och fotoplats.</p>
      </div>
      <div class="card">
        <img src="/brollop_trappa.JPG" alt="Konsultation" />
        <div class="card-head"><h2 class="card-title">Bröllopskonsultation</h2><span class="card-price">Kostnadsfritt</span></div>
        <p class="card-desc">Ett personligt möte i butiken där vi går igenom era visioner.</p>
      </div>
    </div>
    <div class="cta-box">
      <h2>Planerar ni bröllop eller fest?</h2>
      <p style="color:var(--text-muted); margin-top:0.4rem;">Maila oss datum och plats så återkommer vi med inspiration och offert.</p>
      <a href="mailto:flowers@solevasa.se?subject=Bröllopsförfrågan Solé Vasa">Maila flowers@solevasa.se</a>
    </div>
  </main>
</body>
</html>
